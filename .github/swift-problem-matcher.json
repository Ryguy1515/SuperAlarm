{
  "problemMatcher": [
    {
      "owner": "swift-compiler",
      "pattern": [
        {
          "regexp": "^(.+\\.swift):(\\d+):(\\d+):\\s+(error|warning):\\s+(.+)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "message": 5
        }
      ]
    },
    {
      "owner": "xcode-generic",
      "pattern": [
        {
          "regexp": "^(?:.*[\\\\/])?([^\\\\/:]+):(\\d+):(\\d+):\\s+(error|fatal error):\\s+(.+)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "message": 5
        }
      ]
    }
  ]
}
