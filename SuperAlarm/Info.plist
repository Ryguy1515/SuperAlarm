<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>SuperAlarm</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>

	<!-- AlarmKit. Without this key the app cannot schedule system alarms at
	     all. It is an Info.plist string, not an entitlement, which is why it
	     works under free-account signing. -->
	<key>NSAlarmKitUsageDescription</key>
	<string>SuperAlarm schedules alarms with the system so they can ring through Silent mode, Do Not Disturb and Focus — even when the app is closed.</string>

	<!-- Mission permissions. Each is only requested when a mission that needs
	     it is actually used. -->
	<key>NSCameraUsageDescription</key>
	<string>The barcode and object-scan missions use the camera to check you have walked to the thing you registered.</string>
	<key>NSFaceIDUsageDescription</key>
	<string>The Face ID mission uses facial recognition to confirm you are properly awake before the alarm stops.</string>
	<key>NSMotionUsageDescription</key>
	<string>The walk, shake, push-up and squat missions use motion sensors to count your movement.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Your location is used to show the local forecast on the alarm screen and to read it aloud in the voice briefing.</string>

	<!-- Keeps the audio session alive close to an alarm on systems without
	     AlarmKit, and plays the alarm itself once it fires. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>

	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>NSSupportsLiveActivitiesFrequentUpdates</key>
	<true/>

	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>

	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UIRequiresFullScreen</key>
	<true/>
	<key>UIStatusBarStyle</key>
	<string>UIStatusBarStyleLightContent</string>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>

	<!-- An alarm is a portrait experience; rotating mid-mission helps nobody. -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>

	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>

	<key>UIFileSharingEnabled</key>
	<false/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<false/>
</dict>
</plist>
